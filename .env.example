# Streak CRM Configuration
# Get your API key from: https://www.streak.com/api
STREAK_API_KEY=your_streak_api_key_here

# Get your pipeline key from the Streak dashboard URL when viewing a pipeline
# Example: https://mail.google.com/mail/u/0/#pipeline/YOUR_PIPELINE_KEY
# Copy only the key part after #pipeline/
STREAK_PIPELINE_KEY=your_pipeline_key_here

# Get your stage key from Streak API or pipeline settings
# This determines which stage new leads are assigned to
STREAK_STAGE_KEY=your_stage_key_here

# Frontend webhook URL (auto-configured for Vercel deployment)
VITE_STREAK_WEBHOOK_URL=/api/streak-lead
